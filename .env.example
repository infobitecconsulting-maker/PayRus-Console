# Supabase Auth — PayRus's identity layer, shared with App/ (see
# App/.env.example). Both values are public client-side values, not secrets
# (the anon/publishable key is designed to be shipped to browsers). SSO/OAuth
# providers are configured server-side in the Supabase dashboard, never here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# App/'s Convex deployment site URL — used only to call its AI-backed street-
# suggestion HTTP route (src/lib/addressSuggestions.ts). Not a secret.
VITE_CONVEX_SITE_URL=
